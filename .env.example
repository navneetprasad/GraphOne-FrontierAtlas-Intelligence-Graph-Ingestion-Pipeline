# FrontierAtlas / GraphOne Intelligence Graph Pipeline Configuration

# Environment
APP_ENV=production
LOG_LEVEL=INFO

# Network & Concurrency
DEFAULT_CONCURRENCY=25
REQUEST_TIMEOUT_SECONDS=20.0
MAX_RETRIES=4
BASE_BACKOFF_SECONDS=1.5
MAX_BACKOFF_SECONDS=30.0

# Multi-Tier LLM Fallback Chain Keys
# The orchestrator automatically cascades: Gemini Flash -> Groq (Llama 3) -> DeepSeek -> Rule-based
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: GitHub Token to avoid 60 req/hr rate limits when fetching live star counts
GITHUB_TOKEN=your_github_token_here

# Google Sheets Direct Sync (Optional)
# If provided, the exporter will sync all 6 tabs directly to your Google Sheet
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
